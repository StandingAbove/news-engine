# News provider API keys
MARKETAUX_API_KEY=
NEWSAPI_AI_KEY=
EODHD_API_KEY=

# App config
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/news_engine.db

# House model universe (comma-separated tickers)
